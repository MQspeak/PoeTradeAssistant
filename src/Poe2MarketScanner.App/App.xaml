<Application x:Class="Poe2MarketScanner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D1016" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#151A23" />
            <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#1C2330" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#344054" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#F7F2E8" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#9CA8B8" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#D4A84F" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#E9C16B" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#55D6AD" />
            <SolidColorBrush x:Key="AppSelectionBrush" Color="#263752" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="Background" Value="#20293A" />
                <Setter Property="BorderBrush" Value="#3B4B66" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#2D3A51" /><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppAccentBrush}" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#172133" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource AppAccentBrush}" />
                <Setter Property="Background" Value="#101620" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="MinHeight" Value="38" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="Background" Value="#101620" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="MinHeight" Value="38" />
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="Background" Value="{StaticResource AppSurfaceRaisedBrush}" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource AppTextBrush}" /></Style>
            <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource AppTextBrush}" /></Style>

            <Style TargetType="ListBox">
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="Background" Value="#101620" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8" />
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="TabContent" HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabContent" Property="TextElement.Foreground" Value="{StaticResource AppTextBrush}" /><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AppAccentBrush}" /></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabContent" Property="TextElement.Foreground" Value="{StaticResource AppAccentHoverBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="MinRowHeight" Value="42" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="Background" Value="#101620" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="RowBackground" Value="#151A23" />
                <Setter Property="AlternatingRowBackground" Value="#19202C" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="#2D394C" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#26334A" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="BorderBrush" Value="#26334A" />
            </Style>
            <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{StaticResource AppTextBrush}" /><Setter Property="Background" Value="#151A23" /></Style>
            <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{StaticResource AppTextBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="#2D394C" /><Setter Property="Padding" Value="10,6" /></Style>

            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Grid>
                                <Border Margin="0,13,0,0" Padding="{TemplateBinding Padding}" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="9">
                                    <ContentPresenter />
                                </Border>
                                <Border Margin="14,0,0,0" Padding="8,0" Background="{StaticResource AppSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource AppTextBrush}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
