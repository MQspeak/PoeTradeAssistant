<UserControl x:Class="Poe2MarketScanner.App.Views.LiveSearchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="ListView">
   <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
   <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
  </Style>
  <Style TargetType="GridViewColumnHeader">
   <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
   <Setter Property="Background" Value="{StaticResource AppSurfaceRaisedBrush}"/>
   <Setter Property="Padding" Value="8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListViewItem">
   <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
   <Setter Property="Padding" Value="4,7"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="实时搜索 · 本地浏览器实例" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock x:Name="EnvironmentText" Margin="0,8,0,8"/>
   <TextBlock Text="连接 127.0.0.1:9222 的 Chrome/Edge，复用该实例登录态。首屏结果仅展示；后续新命中播放提示音。" Foreground="{StaticResource AppMutedTextBrush}"/>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,16,0,8" x:Name="Actions">
   <ComboBox x:Name="RegionPicker" Width="110" SelectedIndex="0" SelectionChanged="RegionChanged"><ComboBoxItem Content="国际服"/><ComboBoxItem Content="国服"/></ComboBox>
   <Button Margin="8,0,0,0" Click="Login_Click">连接本地浏览器</Button>
   <Button Margin="8,0,0,0" Click="Validate_Click">验证登录</Button>
   <Button Margin="8,0,0,0" Click="Start_Click">启动 / 全部重连</Button>
   <Button Margin="8,0,0,0" Click="Pause_Click">暂停采集</Button>
   <Button Margin="8,0,0,0" Click="Close_Click">关闭会话</Button>
  </WrapPanel>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="请添加搜索链接，然后打开浏览器登录。" TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{StaticResource AppAccentHoverBrush}"/>
  <GroupBox Grid.Row="3" Header="链接库 · 最多200条，启用监控最多10条">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Editor"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,8,8"><TextBlock Text="名称" Margin="0,0,0,5"/><TextBox x:Name="NameInput" ToolTip="链接名称"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,8,8"><TextBlock Text="官方搜索链接" Margin="0,0,0,5"/><TextBox x:Name="UrlInput" ToolTip="当前游戏及区服的官方搜索链接"/></StackPanel>
     <Button Grid.Column="2" Click="Save_Click" Margin="0,0,0,8">添加 / 保存选中</Button>
    </Grid>
    <ListView Grid.Row="1" x:Name="LinkList" SelectionChanged="LinkSelected" MinHeight="80">
     <ListView.View><GridView>
      <GridViewColumn Header="启用" Width="55" DisplayMemberBinding="{Binding Enabled}"/>
      <GridViewColumn Header="名称" Width="155" DisplayMemberBinding="{Binding Name}"/>
      <GridViewColumn Header="搜索链接" Width="580" DisplayMemberBinding="{Binding Url}"/>
     </GridView></ListView.View>
    </ListView>
    <WrapPanel Grid.Row="2" Margin="0,8,0,0" x:Name="LinkActions">
     <Button Click="New_Click">清空选中 / 新建</Button><Button Margin="8,0,0,0" Click="Toggle_Click">启用 / 停用</Button><Button Margin="8,0,0,0" Click="Delete_Click">删除选中</Button><Button Margin="8,0,0,0" Click="Import_Click">导入链接库</Button><Button Margin="8,0,0,0" Click="Export_Click">导出链接库</Button>
    </WrapPanel>
   </Grid>
  </GroupBox>
  <GroupBox Grid.Row="4" Header="命中结果 · 最近50条" Margin="0,14,0,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ListView x:Name="HitList" SelectionChanged="HitSelected">
     <ListView.View><GridView>
      <GridViewColumn Header="时间" Width="85" DisplayMemberBinding="{Binding SeenAt, StringFormat=HH:mm:ss}"/>
      <GridViewColumn Header="初始快照" Width="75" DisplayMemberBinding="{Binding Initial}"/>
      <GridViewColumn Header="监控" Width="120" DisplayMemberBinding="{Binding MonitorName}"/>
      <GridViewColumn Header="物品" Width="260" DisplayMemberBinding="{Binding Title}"/>
      <GridViewColumn Header="价格" Width="170" DisplayMemberBinding="{Binding Price}"/>
     </GridView></ListView.View>
    </ListView>
    <TextBox Grid.Row="1" x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8"/>
    <WrapPanel Grid.Row="2"><Button x:Name="TravelButton" Click="Travel_Click">手动前往藏身处</Button><Button Margin="8,0,0,0" Click="ClearHits_Click">清空结果</Button></WrapPanel>
   </Grid>
  </GroupBox>
 </Grid>
</UserControl>
