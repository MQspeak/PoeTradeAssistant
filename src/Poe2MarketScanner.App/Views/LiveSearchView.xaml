<UserControl x:Class="Poe2MarketScanner.App.Views.LiveSearchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="ListView"><Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/><Setter Property="Background" Value="{StaticResource AppSurfaceRaisedBrush}"/><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/><Setter Property="Padding" Value="4,7"/></Style>
  <Style x:Key="WorkspaceTabs" TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><ContentPresenter Grid.Row="1" Margin="0,12,0,0" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid Margin="32,28,32,36">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="实时搜索" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="EnvironmentText" Margin="0,8,0,0" Foreground="{StaticResource AppMutedTextBrush}"/></StackPanel>
   <WrapPanel Grid.Column="1" VerticalAlignment="Center" x:Name="Actions">
    <ComboBox x:Name="RegionPicker" Width="110" SelectedIndex="0" SelectionChanged="RegionChanged"><ComboBoxItem Content="国际服"/><ComboBoxItem Content="国服"/></ComboBox>
    <Button Margin="8,0,0,0" Click="Login_Click">一键启动 / 连接</Button><Button Margin="8,0,0,0" Click="Validate_Click">验证登录</Button>
    <Button Margin="8,0,0,0" Click="Start_Click">启动 / 全部重连</Button><Button Margin="8,0,0,0" Click="Pause_Click">暂停</Button><Button Margin="8,0,0,0" Click="Close_Click">断开</Button>
   </WrapPanel>
  </Grid>
  <Border Grid.Row="1" Margin="0,18,0,18" Padding="14,10" Background="#182131" BorderBrush="#354866" BorderThickness="1" CornerRadius="8"><TextBlock x:Name="StatusText" Text="请添加搜索链接，然后启动浏览器。" TextWrapping="Wrap" Foreground="{StaticResource AppAccentHoverBrush}"/></Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Margin="0,0,14,0" Padding="18" Background="#151D2A" BorderBrush="#2D3C55" BorderThickness="1" CornerRadius="10">
    <TabControl Style="{StaticResource WorkspaceTabs}">
     <TabItem Header="监控列表">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Margin="0,0,0,10" Foreground="{StaticResource AppMutedTextBrush}" Text="仅展示已启用的链接；修改后点击“启动 / 全部重连”生效。"/>
       <ListView Grid.Row="1" x:Name="MonitorList"><ListView.View><GridView><GridViewColumn Header="名称" Width="180" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="状态" Width="90"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Foreground="{StaticResource AppSuccessBrush}" Text="已启用"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="搜索链接" Width="520" DisplayMemberBinding="{Binding Url}"/></GridView></ListView.View></ListView>
      </Grid>
     </TabItem>
     <TabItem Header="链接库">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid x:Name="Editor"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,10"><TextBlock Text="名称" Margin="0,0,0,5"/><TextBox x:Name="NameInput"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,10"><TextBlock Text="官方搜索链接" Margin="0,0,0,5"/><TextBox x:Name="UrlInput"/></StackPanel><Button Grid.Column="2" Click="Save_Click" Margin="0,20,0,10">添加 / 保存</Button>
       </Grid>
       <ListView Grid.Row="1" x:Name="LinkList" SelectionChanged="LinkSelected"><ListView.View><GridView><GridViewColumn Header="启用" Width="55" DisplayMemberBinding="{Binding Enabled}"/><GridViewColumn Header="名称" Width="170" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="搜索链接" Width="550" DisplayMemberBinding="{Binding Url}"/></GridView></ListView.View></ListView>
       <WrapPanel Grid.Row="2" Margin="0,10,0,0" x:Name="LinkActions"><Button Click="New_Click">新建</Button><Button Margin="8,0,0,0" Click="Toggle_Click">启用 / 停用</Button><Button Margin="8,0,0,0" Click="Delete_Click">删除</Button><Button Margin="8,0,0,0" Click="Import_Click">导入</Button><Button Margin="8,0,0,0" Click="Export_Click">导出</Button></WrapPanel>
      </Grid>
     </TabItem>
    </TabControl>
   </Border>
   <Border Grid.Column="1" Padding="16" Background="#151D2A" BorderBrush="#2D3C55" BorderThickness="1" CornerRadius="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,12"><DockPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="命中结果"/><Button DockPanel.Dock="Right" Padding="8,3" Click="ClearHits_Click">清空</Button></DockPanel>
      <WrapPanel Margin="0,12,0,0"><CheckBox x:Name="AutoTravelToggle" Checked="AutoTravelChanged" Unchecked="AutoTravelChanged">命中立即前往</CheckBox><CheckBox x:Name="ContinuousTravelToggle" Visibility="Collapsed" Margin="14,0,0,0" Checked="AutoTravelChanged" Unchecked="AutoTravelChanged">持续模式</CheckBox></WrapPanel>
      <WrapPanel x:Name="TravelIntervalPanel" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" Text="最小间隔"/><TextBox x:Name="TravelIntervalInput" Width="42" Margin="8,0" Text="3" LostFocus="TravelIntervalLostFocus"/><TextBlock VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" Text="秒（0–99）"/></WrapPanel>
     </StackPanel>
     <ListView Grid.Row="1" x:Name="HitList" SelectionChanged="HitSelected"><ListView.View><GridView><GridViewColumn Header="时间" Width="72" DisplayMemberBinding="{Binding SeenAt, StringFormat=HH:mm:ss}"/><GridViewColumn Header="物品" Width="170" DisplayMemberBinding="{Binding Title}"/><GridViewColumn Header="价格" Width="120" DisplayMemberBinding="{Binding Price}"/></GridView></ListView.View></ListView>
     <TextBox Grid.Row="2" x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10"/>
     <Button Grid.Row="3" x:Name="TravelButton" HorizontalAlignment="Left" Click="Travel_Click">手动前往藏身处</Button>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
