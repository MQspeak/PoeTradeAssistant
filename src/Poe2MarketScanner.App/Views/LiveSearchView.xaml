<UserControl x:Class="Poe2MarketScanner.App.Views.LiveSearchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#294566"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#233A57"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F5F8FC"/>
  <Style TargetType="ListView"><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/><Setter Property="Background" Value="{StaticResource AppSurfaceRaisedBrush}"/><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Selection" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#233A57"/><Setter TargetName="Selection" Property="BorderBrush" Value="#6488B0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#456587"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

  <Style x:Key="WorkspaceTabs" TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><ContentPresenter Grid.Row="1" Margin="0,12,0,0" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid Margin="32,28,32,36">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="实时搜索" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="EnvironmentText" Margin="0,8,0,0" Foreground="{StaticResource AppMutedTextBrush}"/></StackPanel>
   <WrapPanel Grid.Column="1" VerticalAlignment="Center" x:Name="Actions">
    <ComboBox x:Name="RegionPicker" Width="110" SelectedIndex="0" SelectionChanged="RegionChanged"><ComboBoxItem Content="国际服"/><ComboBoxItem Content="国服"/></ComboBox>
    <Button Margin="8,0,0,0" Click="Login_Click">一键启动 / 连接</Button><Button Margin="8,0,0,0" x:Name="ValidateButton" Click="Validate_Click">验证登录</Button>
    <Button Margin="8,0,0,0" x:Name="StartButton" Click="Start_Click">启动全部</Button>
   </WrapPanel>
  </Grid>
  <Border Grid.Row="1" Margin="0,18,0,18" Padding="14,10" Background="#182131" BorderBrush="#354866" BorderThickness="1" CornerRadius="8"><TextBlock x:Name="StatusText" Text="请添加搜索链接，然后启动浏览器。" TextWrapping="Wrap" Foreground="{StaticResource AppAccentHoverBrush}"/></Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Margin="0,0,14,0" Padding="18" Background="#151D2A" BorderBrush="#2D3C55" BorderThickness="1" CornerRadius="10">
    <TabControl x:Name="WorkspaceNavigation" Style="{StaticResource WorkspaceTabs}">
     <TabItem Header="监控列表">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Margin="0,0,0,10" Foreground="{StaticResource AppMutedTextBrush}" Text="单独停止会保留列表项；点击启动全部可重新启动。"/>
       <ListView Grid.Row="1" x:Name="MonitorList" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Border Margin="1,1" Padding="10,7" Background="#182334" BorderBrush="#30445F" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><DockPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource AppSuccessBrush}" Text="{Binding RuntimeStatus}"/></DockPanel><TextBlock Margin="0,6,0,0" Foreground="{StaticResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Url}"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"><Button Padding="8,4" Click="EditMonitor_Click">编辑</Button><Button Margin="6,0,0,0" Padding="8,4" Click="StopMonitor_Click">停止监控</Button></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
      </Grid>
     </TabItem>
     <TabItem Header="链接库">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid x:Name="Editor"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,10"><TextBlock Text="名称" Margin="0,0,0,5"/><TextBox x:Name="NameInput"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,10"><TextBlock Text="官方搜索链接" Margin="0,0,0,5"/><TextBox x:Name="UrlInput"/></StackPanel><Button Grid.Column="2" Click="Save_Click" Margin="0,20,0,10">添加 / 保存</Button>
       </Grid>
       <ListView Grid.Row="1" x:Name="LinkList" SelectionChanged="LinkSelected" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Border Margin="1,1" Padding="10,7" Background="#182334" BorderBrush="#30445F" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><DockPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource AppMutedTextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="待入监控"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Text" Value="已在监控列表"/><Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel><TextBlock Margin="0,6,0,0" Foreground="{StaticResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Url}"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"><Button Padding="8,4" Click="ToggleLinkMonitor_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="放入监控"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Content" Value="移出监控"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Margin="6,0,0,0" Padding="8,4" Click="EditLink_Click">编辑</Button><Button Margin="6,0,0,0" Padding="8,4" Click="DeleteLink_Click">删除</Button></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
       <WrapPanel Grid.Row="2" Margin="0,10,0,0" x:Name="LinkActions"><Button Click="New_Click">新增链接</Button><Button Margin="8,0,0,0" Click="Import_Click">导入</Button><Button Margin="8,0,0,0" Click="Export_Click">导出</Button></WrapPanel>
      </Grid>
     </TabItem>
    </TabControl>
   </Border>
   <Border Grid.Column="1" Padding="16" Background="#151D2A" BorderBrush="#2D3C55" BorderThickness="1" CornerRadius="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,12"><DockPanel LastChildFill="False"><TextBlock FontSize="17" FontWeight="SemiBold" Text="命中结果"/><Button DockPanel.Dock="Right" Width="48" MinWidth="0" Height="26" MinHeight="0" Padding="4,0" Click="ClearHits_Click">清空</Button></DockPanel>
      <WrapPanel Margin="0,12,0,0"><CheckBox x:Name="AutoTravelToggle" Checked="AutoTravelChanged" Unchecked="AutoTravelChanged">命中立即前往</CheckBox><CheckBox x:Name="ContinuousTravelToggle" Visibility="Collapsed" Margin="14,0,0,0" Checked="AutoTravelChanged" Unchecked="AutoTravelChanged">持续模式</CheckBox></WrapPanel>
      <WrapPanel x:Name="TravelIntervalPanel" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" Text="最小间隔"/><TextBox x:Name="TravelIntervalInput" Width="42" Margin="8,0" Text="3" LostFocus="TravelIntervalLostFocus"/><TextBlock VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" Text="秒（0–99）"/></WrapPanel>
     </StackPanel>
     <ListView Grid.Row="1" x:Name="HitList" BorderThickness="0"><ListView.ItemTemplate><DataTemplate>
      <Border Margin="1" Padding="10,8" Background="#182334" BorderBrush="#30445F" BorderThickness="1" CornerRadius="7" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000">
       <Border.ToolTip><ToolTip Background="#111B29" Foreground="#E8EDF5" BorderBrush="#48617F" Padding="16" Placement="Left"><ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto"><TextBlock Width="340" TextWrapping="Wrap" Text="{Binding Hit.Detail}"/></ScrollViewer></ToolTip></Border.ToolTip>
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Binding Hit.TitleColor}" Text="{Binding Hit.Title}" Margin="0,0,8,0"/>
        <TextBlock Grid.Row="1" Margin="0,5,8,0" Foreground="{StaticResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Hit.MonitorName}"/>
        <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource AppAccentHoverBrush}" Text="{Binding Hit.Price}"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
         <Button Width="28" Height="26" MinWidth="0" MinHeight="0" Padding="0" Click="TravelHit_Click" IsEnabled="{Binding Hit.CanTravel}" ToolTip="前往藏身处"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;"/></Button>
         <Button Width="28" Height="26" MinWidth="0" MinHeight="0" Padding="0" Margin="5,0,0,0" Click="MarkRead_Click" ToolTip="标记已读"><TextBlock FontFamily="Segoe MDL2 Assets"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE8A4;"/><Setter Property="Foreground" Value="#AAB8CC"/><Style.Triggers><DataTrigger Binding="{Binding Read}" Value="True"><Setter Property="Text" Value="&#xE73E;"/><Setter Property="Foreground" Value="#70D7AE"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button>
        </StackPanel>
       </Grid>
      </Border>
     </DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
