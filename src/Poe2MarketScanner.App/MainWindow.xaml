<ui:FluentWindow x:Class="Poe2MarketScanner.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:calculator="clr-namespace:Poe2MarketScanner.App.Services" xmlns:views="clr-namespace:Poe2MarketScanner.App.Views"
                 Title="POE 交易助手" Width="1480" MinWidth="1120" Height="920" MinHeight="700"
                 Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource AppTextBrush}"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" /><Setter Property="BorderBrush" Value="{StaticResource AppAccentHoverBrush}" /><Setter Property="Foreground" Value="#1A1409" />
        </Style>
        <Style x:Key="SidebarTabItem" TargetType="TabItem">
            <Setter Property="Width" Value="212" /><Setter Property="Height" Value="64" /><Setter Property="Margin" Value="0,2" /><Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="NavItem" Background="Transparent" CornerRadius="8,8,8,8" Margin="0,2"><Grid><Border x:Name="ActiveIndicator" Width="3" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" CornerRadius="0,2,2,0" /><ContentPresenter x:Name="NavContent" Margin="14,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" ContentSource="Header" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#1D2A3D" /><Setter TargetName="ActiveIndicator" Property="Background" Value="{StaticResource AppAccentBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#182335" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#223047" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarTabControl" TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsItemsHost="True" Orientation="Vertical" /></ScrollViewer></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="CalculatorStepTabs" TargetType="TabControl">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TabPanel IsItemsHost="True" HorizontalAlignment="Left" /><ContentPresenter Grid.Row="1" Margin="0,18,0,0" ContentSource="SelectedContent" /></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CalculatorComboCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SectionCaption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" /><Setter Property="FontSize" Value="13" /></Style>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource AppTextBrush}" /></Style>
    </Window.Resources>

    <Grid>
    <Grid x:Name="ApplicationContent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="244" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2" Background="#111722" BorderBrush="#29364A" BorderThickness="0,0,1,0">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top" Margin="0,14,0,24"><TextBlock FontSize="20" FontWeight="SemiBold" Text="POE 交易助手" /><TextBlock Style="{StaticResource SectionCaption}" Margin="0,6,0,0" Text="市场扫描与套利决策" /><Border Margin="0,20,0,2" Padding="12" Background="#182131" BorderBrush="#2D3C55" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Style="{StaticResource SectionCaption}" Text="游戏工作区" /><StackPanel x:Name="GameModeSelector" Margin="0,10,0,0" Orientation="Horizontal"><RadioButton GroupName="GameMode" IsChecked="{Binding IsPoe1Mode, Mode=TwoWay}" FontWeight="SemiBold">POE1</RadioButton><RadioButton GroupName="GameMode" IsChecked="{Binding IsPoe2Mode, Mode=TwoWay}" Margin="18,0,0,0" FontWeight="SemiBold">POE2</RadioButton></StackPanel><Border Height="1" Margin="0,12,0,10" Background="#2D3C55" /><TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppSuccessBrush}" Text="{Binding ActiveGameDisplayName, StringFormat={}{0} 工作区已启用}" /><TextBlock Style="{StaticResource SectionCaption}" Margin="0,5,0,0" Text="扫描配置与计算数据独立保存" TextWrapping="Wrap" /></StackPanel></Border><TextBlock Style="{StaticResource SectionCaption}" Margin="0,18,0,4" Text="功能" /></StackPanel>
                    <TabControl x:Name="PrimaryNavigation" TabStripPlacement="Left" Style="{StaticResource SidebarTabControl}" ItemContainerStyle="{StaticResource SidebarTabItem}">
                        <TabItem><TabItem.Header><Grid Width="184"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#26344A" CornerRadius="7"><ui:SymbolIcon Symbol="Search24" FontSize="18" Foreground="{StaticResource AppAccentHoverBrush}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="15" FontWeight="SemiBold" Text="扫价器" /><TextBlock Style="{StaticResource SectionCaption}" Margin="0,3,0,0" FontSize="11" Text="扫描与 OCR" /></StackPanel></Grid></TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28,32,40">
                                <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource PageTitle}" Text="扫价器" /><TextBlock Style="{StaticResource SectionCaption}" Margin="0,8,0,0" Text="准备交易界面、校准识别区域，然后执行批量查询。" /></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Margin="0,0,8,0" Click="ImportProfile_Click">导入配置</Button><Button Margin="0,0,8,0" Click="SaveProfile_Click">保存配置</Button><Button Margin="0,0,8,0" Click="ToggleOverlayEdit_Click">编辑标注</Button><Button Click="HideOverlay_Click">隐藏标注</Button></WrapPanel></Grid>
                                <Border Margin="0,0,0,24" Padding="18" Background="#182131" BorderBrush="#354866" BorderThickness="1" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Text="扫描准备" /><TextBlock Style="{StaticResource SectionCaption}" Margin="0,6,0,0" Text="确认交易模式、待查询通货和屏幕标注后开始。" /><TextBlock Margin="0,10,0,0" Foreground="{StaticResource AppSuccessBrush}" Text="{Binding QueryItems.Count, StringFormat=当前已载入 {0} 个待查询通货}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StopAutomationButton" Margin="0,0,10,0" Click="StopAutomation_Click" IsEnabled="False">停止 (F8)</Button><Button x:Name="RunAutomationButton" Style="{StaticResource PrimaryActionButton}" Click="RunSellAutomation_Click">开始自动查询 (F7)</Button></StackPanel></Grid></Border>
                                <TabControl>
                                    <TabItem Header="扫描设置"><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <GroupBox Header="扫描参数" Grid.Column="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,12">交易模式</TextBlock><ComboBox Grid.Column="1" Margin="0,0,0,12" ItemsSource="{Binding TradeModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Key" SelectedValue="{Binding SelectedTradeModeKey}" />
                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,12">游戏内名称</TextBlock><CheckBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" IsChecked="{Binding UseTraditionalChinese}">游戏使用繁体名称时启用</CheckBox>
                                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,12">输出目录</TextBlock><Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Margin="0,0,8,0" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Click="BrowseOutputDirectory_Click">打开目录</Button></Grid>
                                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,12">公共操作间隔</TextBlock><TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Text="{Binding Profile.Automation.CommonDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,0">是否识别金币</TextBlock><CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding RecognizeGoldCost}">查询时识别金币成本</CheckBox>
                                        </Grid></GroupBox>
                                        <GroupBox Grid.Column="1" Margin="16,0,0,0" Header="待查询通货"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><WrapPanel><Button Margin="0,0,8,0" Click="ImportQueryFile_Click">导入通货列表</Button><Button Click="BrowseOutputDirectory_Click">打开结果目录</Button></WrapPanel><TextBlock Style="{StaticResource SectionCaption}" Margin="0,10,0,0" Text="导入文本文件后会显示在下方。" /></StackPanel><ListBox ItemsSource="{Binding QueryItems}" MinHeight="220" /></DockPanel></GroupBox>
                                    </Grid></TabItem>
                                    <TabItem Header="校准与 OCR"><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <WrapPanel Grid.ColumnSpan="2" Margin="0,0,0,16"><Button Margin="0,0,8,0" Click="ToggleOverlayEdit_Click">打开标注编辑</Button><Button Margin="0,0,8,0" Click="RunScreenOcrDebug_Click">运行屏幕 OCR 调试</Button><Button Margin="0,0,8,0" Click="OpenDebugDirectory_Click">打开调试目录</Button><Button Click="ResetProfile_Click">重置当前工作区配置</Button></WrapPanel>
                                        <GroupBox Grid.Row="1" Header="识别区域"><DataGrid ItemsSource="{Binding RegionEntries}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="名称" Binding="{Binding Region.Name}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="X" Binding="{Binding Region.X, StringFormat=F1}" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="Y" Binding="{Binding Region.Y, StringFormat=F1}" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="宽" Binding="{Binding Region.Width, StringFormat=F1}" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="高" Binding="{Binding Region.Height, StringFormat=F1}" /></DataGrid.Columns></DataGrid></GroupBox>
                                        <GroupBox Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" Header="点击锚点"><DataGrid ItemsSource="{Binding AnchorEntries}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="名称" Binding="{Binding Anchor.Name}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="X" Binding="{Binding Anchor.X, StringFormat=F1}" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="Y" Binding="{Binding Anchor.Y, StringFormat=F1}" /></DataGrid.Columns></DataGrid></GroupBox>
                                        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="OCR 解析预览"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="金币原文" /><TextBox Margin="0,6,0,12" Text="{Binding GoldCostRawText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsGoldCostInputEnabled}" /><TextBlock Text="比例原文" /><TextBox Margin="0,6,0,12" Text="{Binding RatioRawText, UpdateSourceTrigger=PropertyChanged}" /><Button HorizontalAlignment="Left" Click="ParseOcrPreview_Click">解析 OCR 文本</Button><TextBlock Margin="0,12,0,0" Foreground="{StaticResource AppSuccessBrush}" TextWrapping="Wrap" Text="{Binding OcrPreviewSummary}" /></StackPanel><DataGrid Grid.Column="1" ItemsSource="{Binding DebugRegions}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="区域" Binding="{Binding RegionName}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="识别文本" Binding="{Binding RawText}" Width="*" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="状态" Binding="{Binding Status}" /></DataGrid.Columns></DataGrid></Grid></GroupBox>
                                    </Grid></TabItem>
                                </TabControl>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem><TabItem.Header><Grid Width="184"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#26344A" CornerRadius="7"><ui:SymbolIcon Symbol="Calculator24" FontSize="18" Foreground="{StaticResource AppAccentHoverBrush}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="15" FontWeight="SemiBold" Text="套利计算器" /><TextBlock Style="{StaticResource SectionCaption}" Margin="0,3,0,0" FontSize="11" Text="价格与收益" /></StackPanel></Grid></TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28,32,40">
                                <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource PageTitle}" Text="套利计算器" /><TextBlock Style="{StaticResource SectionCaption}" Margin="0,8,0,0" Text="导入扫价结果，设置交易对并查看标的收益。" /></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Click="ImportCalculatorScan_Click">导入 V2 价格表</Button></WrapPanel></Grid>
                                <TabControl Style="{StaticResource CalculatorStepTabs}">
                                    <TabItem Header="1. 资产与成本"><ui:Card Padding="20" Margin="0,18,0,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><WrapPanel><Button Margin="0,0,8,0" Click="AddCalculatorCurrency_Click">新增币种</Button><Button Click="AddCalculatorTargetItem_Click">新增标的物</Button></WrapPanel><TextBlock Style="{StaticResource SectionCaption}" Margin="0,12,0,0" Text="先录入币种与标的物，并补齐获得成本；这是后续计算的基础。" /></StackPanel><DataGrid x:Name="CalculatorItemsGrid" ItemsSource="{Binding Calculator.Items}" CellEditEnding="CalculatorGrid_CellEditEnding"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="物品名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" /><DataGridTemplateColumn Header="类型" Width="150" CellStyle="{StaticResource CalculatorComboCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox SelectedValue="{Binding Category, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag"><ComboBoxItem Tag="{x:Static calculator:CalculatorItemCategory.Currency}">币种</ComboBoxItem><ComboBoxItem Tag="{x:Static calculator:CalculatorItemCategory.Target}">标的物</ComboBoxItem></ComboBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="每获得 1 个时的金币成本" Binding="{Binding GoldCostText, UpdateSourceTrigger=PropertyChanged}" Width="240" /><DataGridTemplateColumn Header="操作" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Click="RemoveCalculatorItem_Click">删除</Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></DockPanel></ui:Card></TabItem>
                                    <TabItem Header="2. 交易对"><ui:Card Padding="20" Margin="0,18,0,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><Button HorizontalAlignment="Left" Click="AddCalculatorPair_Click">新增基础交易对</Button><TextBlock Style="{StaticResource SectionCaption}" Margin="0,12,0,0" Text="定义换汇路径：1 个卖出币种可换得多少买入币种；完成后再评估标的。" /></StackPanel><DataGrid x:Name="CalculatorPairsGrid" ItemsSource="{Binding Calculator.Pairs}" CellEditEnding="CalculatorGrid_CellEditEnding"><DataGrid.Columns><DataGridTemplateColumn Header="卖出币种" Width="*" CellStyle="{StaticResource CalculatorComboCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Calculator.CurrencyItems, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedItem="{Binding BaseItem, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="买入币种" Width="*" CellStyle="{StaticResource CalculatorComboCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Calculator.CurrencyItems, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedItem="{Binding QuoteItem, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="汇率" Binding="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" Width="180" /><DataGridTemplateColumn Header="操作" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Click="RemoveCalculatorPair_Click">删除</Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></DockPanel></ui:Card></TabItem>
                                    <TabItem Header="标的套利"><StackPanel><WrapPanel Margin="0,0,0,14"><StackPanel Orientation="Horizontal" Margin="0,0,24,8"><TextBlock Text="基础交易对" VerticalAlignment="Center" Margin="0,0,12,0" /><ComboBox Width="360" ItemsSource="{Binding Calculator.Pairs}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Calculator.SelectedPair, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSynchronizedWithCurrentItem="False" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="盈利模式" VerticalAlignment="Center" Margin="0,0,12,0" /><ComboBox Width="160" ItemsSource="{Binding Calculator.ProfitModes}" SelectedItem="{Binding Calculator.ProfitMode, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></WrapPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource SectionCaption}" VerticalAlignment="Center" Text="{Binding Calculator.SelectedPairSummary}" TextWrapping="Wrap" /><Button Grid.Column="1" Margin="16,0,0,0" Click="AddCalculatorTarget_Click">新增套利标的</Button></Grid><ui:Card Padding="20"><DataGrid x:Name="CalculatorTargetsGrid" ItemsSource="{Binding Calculator.Targets}" CellEditEnding="CalculatorGrid_CellEditEnding" Sorting="CalculatorTargetsGrid_Sorting"><DataGrid.Columns><DataGridTemplateColumn Header="标的物" Width="*" CellStyle="{StaticResource CalculatorComboCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Calculator.TargetItems, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedItem="{Binding TargetItem, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="买入价" Binding="{Binding ActiveBuyPriceText, UpdateSourceTrigger=PropertyChanged}" Width="100" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="卖出价" Binding="{Binding ActiveSellPriceText, UpdateSourceTrigger=PropertyChanged}" Width="100" /><DataGridTemplateColumn x:Name="CalculatorRoiColumn" Header="ROI" SortMemberPath="RoiValue" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RoiText}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TableTextDisplay}"><Style.Triggers><DataTrigger Binding="{Binding IsPositiveRoi}" Value="True"><Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger><DataTrigger Binding="{Binding IsNegativeRoi}" Value="True"><Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn x:Name="CalculatorGoldEfficiencyColumn" ElementStyle="{StaticResource TableTextDisplay}" Header="金币转化率" SortMemberPath="GoldEfficiencyValue" Binding="{Binding GoldEfficiencyText}" IsReadOnly="True" Width="150" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="净利润" Visibility="Collapsed" Binding="{Binding NetProfitText}" IsReadOnly="True" Width="140" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="总金币成本" Visibility="Collapsed" Binding="{Binding TotalGoldCostText}" IsReadOnly="True" Width="140" /><DataGridTextColumn ElementStyle="{StaticResource TableTextDisplay}" EditingElementStyle="{StaticResource TableTextEditor}" Header="计算提示" Binding="{Binding Hint}" IsReadOnly="True" Width="210" /><DataGridTemplateColumn Header="操作" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Click="RemoveCalculatorTarget_Click">删除</Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></ui:Card></StackPanel></TabItem>
                                </TabControl>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem><TabItem.Header><Grid Width="184"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#26344A" CornerRadius="7"><ui:SymbolIcon Symbol="GlobeSearch24" FontSize="18" Foreground="{StaticResource AppAccentHoverBrush}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="15" FontWeight="SemiBold" Text="实时搜索" /><TextBlock Style="{StaticResource SectionCaption}" Margin="0,3,0,0" FontSize="11" Text="监控与命中" /></StackPanel></Grid></TabItem.Header><views:LiveSearchView x:Name="LiveSearch" /></TabItem>
                    </TabControl>
                </DockPanel>
        </Border>
        <ui:TitleBar Grid.Column="1" Grid.Row="0" Title="" ShowMinimize="True" ShowMaximize="True" ShowClose="True" />
        <Grid Grid.Column="1" Grid.Row="1">
            <ContentPresenter Content="{Binding SelectedContent, ElementName=PrimaryNavigation}" />
        </Grid>
    </Grid>
        <Border x:Name="ShutdownOverlay" Visibility="Collapsed" Background="#CC0D1016"
                Panel.ZIndex="1000" Cursor="Wait" Focusable="True">
            <Border Background="{StaticResource AppSurfaceRaisedBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="32" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="正在保存工作区" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="ShutdownStatusText" Margin="0,12,0,20" TextWrapping="Wrap"
                               Text="正在保存所有工作区的数据、配置和设置，完成后将自动退出。" />
                    <ProgressBar IsIndeterminate="True" Height="5" />
                    <TextBlock Margin="0,16,0,0" Foreground="{StaticResource AppMutedTextBrush}"
                               Text="请稍候，保存期间暂时无法操作。" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
