<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlaywrightPlatform>win</PlaywrightPlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.60.0" />
    <EmbeddedResource Include="Scripts/*.js" />
    <EmbeddedResource Include="Data/poe1-en-cn.json" />
    <EmbeddedResource Include="Data/poe2-en-cn.json" />
    <None Include="Data/TRANSLATION-SOURCE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data/POE1-TRANSLATION-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

